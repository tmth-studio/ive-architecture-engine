{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IVE architecture artifact",
  "type": "object",
  "required": ["schema_version", "venture", "requirements", "components", "evidence", "financial_model", "open_items"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "venture": {"type": "string", "minLength": 3},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "statement", "bottleneck", "intervention", "component_ids", "evidence_ids", "verification"]}},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "purpose"]}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["id", "claim", "status", "source_or_test"]}},
    "financial_model": {"type": "object", "required": ["price_ceiling", "cost_floor", "fmos"]},
    "open_items": {"type": "array"}
  }
}
